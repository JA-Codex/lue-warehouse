# ==============================================================================
# LUE Warehouse - Local Environment Configuration (US-0.4)
# ==============================================================================
# Instructions:
# 1. Copy this file to create your local .env file:
#      cp .env.example .env          (Linux / macOS / Git Bash)
#      copy .env.example .env        (Windows Command Prompt)
#      Copy-Item .env.example .env   (Windows PowerShell)
# 2. Update the credentials below to match your local PostgreSQL installation.
# 3. NEVER commit your actual .env file to version control (.gitignore ignores it).
# ==============================================================================

# PostgreSQL Server Connection (Admin / Superuser used for setup and connection testing)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres

# Target Databases
PGDATABASE=lue_warehouse
PGDATABASE_SOURCE=lue_source

# Application Roles (Created in US-1.1)
LUE_ETL_USER=lue_etl
LUE_ETL_PASSWORD=lue_etl_secure_pass_123

LUE_READER_USER=lue_reader
LUE_READER_PASSWORD=lue_reader_secure_pass_123

# Environment mode (development / production)
ENVIRONMENT=development

